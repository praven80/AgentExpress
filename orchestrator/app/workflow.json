{
  "$comment": "THIS FILE IS THE WORKFLOW — edit it (plus terraform.tfvars) and you have your own multi-agent system. Blocks: orchestrator (engine settings), ui (branding), guardrail (content safety), authorization (who may approve/re-run/cancel/evaluate/delete), tools (your data sources), agents (one per folder under app/subagents/<id>/), steps (topology + review gates + branch conditions). Both Terraform and CDK read this file, so declaring a tool or agent here provisions its infrastructure — no IaC edits. Every key is documented in orchestrator/docs/WORKFLOW_REFERENCE.md. Reformat after editing: python3 format_workflow.py",
  "orchestrator": {
    "defaultModel": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "runtimeInvoke": { "maxAttempts": 1, "readTimeoutSeconds": 120 },
    "policy": { "enabled": true, "mode": "ENFORCE" },
    "chatbot": {
      "enabled": true,
      "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "greeting": "Hi! I can answer questions about your workflow runs — status, cost, latency, outputs, guardrails, evaluations — and take actions like approving a review gate, re-running an agent, or running an evaluation. What would you like to know?",
      "placeholder": "Ask about a run, or tell me to do something…",
      "tools": {
        "status": true,
        "sessions": true,
        "outputs": true,
        "costs": true,
        "latency": true,
        "guardrails": true,
        "evals": true,
        "runEval": true,
        "rerun": true,
        "review": true
      }
    }
  },
  "ui": {
    "title": "Multi-Agent Orchestrator",
    "heading": "🧭 Multi-Agent Orchestrator",
    "defaultTopic": "Design a serverless data pipeline on AWS",
    "topicPlaceholder": "What should the workflow work on?",
    "subjectPlaceholder": "Subject (optional, for memory)",
    "assistantTitle": "Run Assistant",
    "assistantSubtitle": "Ask about status, cost, evals — or run actions"
  },
  "guardrail": {
    "blockedInputMessage": "This request was blocked by the content guardrail.",
    "blockedOutputMessage": "The generated content was blocked by the content guardrail.",
    "contentFilters": {
      "HATE": "MEDIUM",
      "VIOLENCE": "MEDIUM",
      "SEXUAL": "HIGH",
      "INSULTS": "MEDIUM",
      "MISCONDUCT": "MEDIUM",
      "PROMPT_ATTACK": "HIGH"
    },
    "deniedWords": ["BLOCKED_DEMO_TERM"],
    "managedWordLists": ["PROFANITY"],
    "deniedTopics": [
      {
        "name": "LegalAdvice",
        "definition": "Statements that give specific legal advice, or assert what a reader is legally obliged or entitled to do.",
        "examples": [
          "You are legally required to sign this contract.",
          "You can ignore that clause — it isn't enforceable."
        ]
      }
    ],
    "piiEntities": { "US_SOCIAL_SECURITY_NUMBER": "BLOCK", "EMAIL": "ANONYMIZE" }
  },
  "authorization": {
    "groupsClaim": "cognito:groups",
    "actions": {
      "decision": ["approvers"],
      "rerun": ["approvers"],
      "cancel": ["approvers", "operators"],
      "evaluate": ["operators"],
      "insights": ["operators"],
      "delete": ["operators"]
    }
  },
  "tools": {
    "kb": {
      "type": "kb",
      "description": "Bedrock Knowledge Base over kb_docs/, on S3 Vectors, via a Gateway Lambda target. Each top-level folder under kb_docs/ is a corpus (doc_type) an agent can be scoped to.",
      "corpora": ["reference"],
      "policy": {
        "tool": "retrieve",
        "restrictTo": {
          "filter": ["reference"]
        }
      }
    },
    "websearch": {
      "type": "websearch",
      "description": "AgentCore Web Search - a managed built-in Gateway connector. No API keys, no infrastructure, queries never leave AWS. us-east-1, eu-west-1, ap-northeast-1 only.",
      "maxResults": 10,
      "excludeDomains": [],
      "includeDomains": [],
      "targetIncludeDomains": [],
      "targetExcludeDomains": []
    },
    "docs": {
      "type": "mcp",
      "endpoint": "https://knowledge-mcp.global.api.aws",
      "call": "aws___search_documentation",
      "arg": "search_phrase",
      "args": { "limit": 5 },
      "listingMode": "DYNAMIC",
      "description": "AWS Knowledge MCP Server - managed by AWS, fronted by the Gateway over Streamable HTTP. Nothing to deploy, no credentials. Publishes five tools over live AWS content."
    },
    "pricing": {
      "type": "lambda",
      "source": "tool_lambda",
      "call": "aws_prices",
      "arg": "services",
      "description": "Real AWS on-demand unit prices, via an AWS Lambda target. The type=\"lambda\" demonstration: a Lambda reaches what the Gateway cannot - a warehouse, an RDBMS, a VPC, or here a control-plane API with no MCP server in front of it. Returns RATES, never a total: a total needs usage volumes, which are a property of the workload and not of AWS.",
      "rowFields": {
        "service": "service",
        "dimension": "dimension",
        "unit": "unit",
        "price": "pricePerUnit",
        "currency": "currency",
        "region": "region",
        "requested": "requestedAs"
      },
      "toolSchema": [
        {
          "name": "aws_prices",
          "description": "On-demand unit prices for the named AWS services in one region, from the AWS Price List Query API. Unit rates only, never a total.",
          "properties": {
            "services": {
              "type": "string",
              "required": true,
              "description": "Comma-separated AWS service names, e.g. \"Amazon Bedrock, AWS Lambda, DynamoDB\"."
            },
            "region": {
              "type": "string",
              "required": false,
              "description": "Region code to price for, e.g. \"us-east-1\". Defaults to the deployment's own region."
            }
          }
        }
      ]
    }
  },
  "agents": {
    "intake": {
      "name": "Request Intake",
      "runtime": "main",
      "maxTokens": 3000,
      "access": ["Session input (topic)"],
      "produces": "request-brief",
      "agentcore": {
        "guardrails": { "input": true },
        "evaluations": {
          "enabled": true,
          "auto": true,
          "evaluators": ["Builtin.Faithfulness", "Builtin.Correctness", "Builtin.InstructionFollowing"]
        }
      }
    },
    "knowledge_research": {
      "name": "Knowledge Base Research",
      "runtime": "dedicated",
      "tool": "kb",
      "corpus": "reference",
      "maxTokens": 4000,
      "produces": "research-finding",
      "agentcore": {
        "evaluations": {
          "enabled": true,
          "auto": false,
          "evaluators": ["Builtin.Faithfulness", "Builtin.ResponseRelevance"]
        },
        "policy": { "enabled": true }
      }
    },
    "web_search": {
      "name": "Web Search Research",
      "runtime": "dedicated",
      "tool": "websearch",
      "maxTokens": 4000,
      "produces": "research-finding",
      "agentcore": {
        "guardrails": { "output": true },
        "evaluations": {
          "enabled": true,
          "auto": false,
          "evaluators": ["Builtin.Faithfulness", "Builtin.ResponseRelevance"]
        },
        "policy": { "enabled": true }
      }
    },
    "documentation_search": {
      "name": "MCP Documentation Research",
      "runtime": "dedicated",
      "tool": "docs",
      "maxTokens": 4000,
      "produces": "research-finding",
      "agentcore": {
        "guardrails": { "output": true },
        "evaluations": {
          "enabled": true,
          "auto": false,
          "evaluators": ["Builtin.Faithfulness", "Builtin.ResponseRelevance"]
        },
        "policy": { "enabled": true }
      }
    },
    "cost_research": {
      "name": "Cost Research",
      "runtime": "main",
      "tool": "pricing",
      "maxTokens": 1500,
      "produces": "research-finding",
      "agentcore": {
        "evaluations": {
          "enabled": true,
          "auto": false,
          "evaluators": ["Builtin.Faithfulness", "Builtin.ResponseRelevance"]
        },
        "policy": { "enabled": true }
      }
    },
    "analysis": {
      "name": "Analysis",
      "runtime": "main",
      "maxTokens": 6000,
      "access": ["Upstream assets (orchestrator graph state)"],
      "produces": "analysis",
      "agentcore": {
        "memory": {
          "longTerm": ["semantic"]
        },
        "guardrails": { "output": true },
        "evaluations": {
          "enabled": true,
          "auto": true,
          "evaluators": ["Builtin.Faithfulness", "Builtin.Correctness", "Builtin.Coherence"]
        }
      }
    },
    "recommendation": {
      "name": "Recommendation",
      "runtime": "main",
      "maxTokens": 6000,
      "access": ["Upstream assets (orchestrator graph state)"],
      "produces": "recommendation",
      "agentcore": {
        "memory": {
          "longTerm": ["semantic", "summary"]
        },
        "guardrails": { "output": true },
        "evaluations": {
          "enabled": true,
          "auto": true,
          "evaluators": ["Builtin.Helpfulness", "Builtin.InstructionFollowing"]
        }
      }
    },
    "report": {
      "name": "Report",
      "runtime": "main",
      "maxTokens": 8000,
      "access": ["Upstream assets (orchestrator graph state)"],
      "produces": "report",
      "agentcore": {
        "guardrails": { "input": true, "output": true },
        "evaluations": {
          "enabled": true,
          "auto": true,
          "evaluators": ["Builtin.Faithfulness", "Builtin.Coherence", "Builtin.Conciseness"]
        }
      }
    }
  },
  "steps": [
    {
      "agent": "intake",
      "hitl": true,
      "branch": {
        "when": [
          { "field": "objective", "exists": false, "goto": "END" },
          { "field": "keyQuestions", "lt": 1, "goto": "analysis_reco" }
        ]
      }
    },
    {
      "parallel": ["knowledge_research", "web_search", "documentation_search", "cost_research"],
      "hitl": true,
      "gateId": "research",
      "gateName": "Research"
    },
    {
      "sequence": ["analysis", "recommendation"],
      "hitl": true,
      "gateId": "analysis_reco",
      "gateName": "Analysis & Recommendation"
    },
    { "agent": "report" }
  ]
}
